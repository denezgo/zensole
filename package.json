{
  "name": "zensole",
  "version": "0.1.0",
  "description": "Zensole - an utility to make logging like node.js built-in `console`.",
  "keywords": [
    "log",
    "debug",
    "logger",
    "console"
  ],
  "homepage": "https://github.com/denezgo/zensole#readme",
  "bugs": {
    "url": "https://github.com/denezgo/zensole/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denezgo/zensole.git"
  },
  "license": "MIT",
  "author": "denezgo",
  "type": "module",
  "main": "dist/zen.js",
  "types": "dist/zen.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./zen.mjs"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run test && npm run build",
    "test": "tsx --test src/*.test.ts",
    "publish": "npm run prepublishOnly && npm publish"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "chalk": "^5.6.2"
  }
}
