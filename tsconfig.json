{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "types": ["@types/node"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}